# === Skills 跨平台路径配置 ===
# 复制此文件为 .env 并填入本机实际路径
# cp .env.example .env
#
# 此文件不入 Git，每台机器各一份

# ETL 数据导入管线项目（Excel/CSV/爬虫 → 数据库的并发导入引擎）
ETL_PIPELINES_DIR=D:\Work\DataProject\数据导入程序

# dunhill 业务数据根目录（日报 Excel、调价清单等业务文件）
DUNHILL_DATA_DIR=D:\Work\dunhill

# AI/自动化项目目录（product-info-updater、product-checker 等项目）
AI_PROJECTS_DIR=D:\Work\ai\projects

# 浏览器下载目录
DOWNLOAD_DIR=D:\Users\Downloads

# Playwright 浏览器 profile 存储（多个 skill 共享）
PLAYWRIGHT_PROFILES_DIR=D:\Work\ai\browser_profiles
